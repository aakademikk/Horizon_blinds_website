# ---------------------------------------------------------------------------
# Fab Shutters & Blinds — environment
#
# Copy to `.env.local` and fill in what you have. Every value here is optional:
# with none of them set, the site builds, runs and accepts enquiries (the API
# route validates and responds, it simply has nowhere to file them).
# ---------------------------------------------------------------------------

# Canonical origin. Used for metadata, Open Graph, sitemap and schema.org.
NEXT_PUBLIC_SITE_URL="https://www.fabshuttersandblinds.co.uk"

# --- Supabase --------------------------------------------------------------
# Create a project at supabase.com, then run the SQL in README → "Supabase".
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-side only. Bypasses row-level security, so never expose it publicly.
SUPABASE_SERVICE_ROLE_KEY=""
# Optional: defaults to "enquiries".
SUPABASE_ENQUIRIES_TABLE="enquiries"

# --- Outbound webhook ------------------------------------------------------
# Every enquiry is POSTed here as JSON. Works with Zapier, Make, n8n, a CRM
# endpoint, or anything that accepts a webhook.
ENQUIRY_WEBHOOK_URL=""
# Sent as the X-Webhook-Secret header so the receiver can verify the caller.
ENQUIRY_WEBHOOK_SECRET=""
